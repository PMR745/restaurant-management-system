# ============================================================================
# Noir & Gold — environment
#
# Everything here is OPTIONAL. With no .env.local at all the app runs on the
# local sync adapter: zero configuration, syncs across tabs of one browser.
# Copy this file to .env.local only when you want to change that.
# ============================================================================

# ── Cross-device sync (optional) ────────────────────────────────────────────
# Set BOTH to switch from the local adapter to Supabase Postgres + Realtime.
# Setup: docs/SUPABASE.md
#
# These are NEXT_PUBLIC_, so they are inlined into the browser bundle at BUILD
# time. Changing them on Vercel requires a redeploy, not a restart.
#
# Never put the service_role key here. It bypasses RLS and this file's contents
# are public by design.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── QR codes (optional) ─────────────────────────────────────────────────────
# Table tents are generated against window.location.origin by default, which is
# correct almost always. Set this only if you are generating printable codes
# from one host that must point at another.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ── Staff gate (optional) ───────────────────────────────────────────────────
# The gate is OFF by default: a POC link should let anyone walk every role
# without being handed four PINs first. Set to 0 to enforce sign-in on
# /admin, /kitchen, /waiter and /takeaway.
# DEMO_OPEN_ACCESS=0

# Server-only — never NEXT_PUBLIC_. Used to sign the session cookie.
# There is a development fallback so the demo works unconfigured; it is not a
# secret and is committed. Set a real one for anything beyond a demo.
# AUTH_SECRET=<32+ random bytes, base64>

# Per-role PINs. Defaults (shown on the login screen) are 4829 / 7712 / 3305 / 9044.
# ADMIN_PIN=4829
# KITCHEN_PIN=7712
# WAITER_PIN=3305
# FRONTDESK_PIN=9044
